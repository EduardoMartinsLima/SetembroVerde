# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA versione o arquivo ".env" (já está no .gitignore).

PORT=3000
ADMIN_KEY=defina-uma-chave-forte

# --- SQL Server ---
DB_SERVER=nome-ou-ip-do-servidor
DB_DATABASE=SetembroVerde
DB_USER=usuario_app
DB_PASSWORD=

# Opcionais — descomente e ajuste se necessário
# DB_PORT=1433
# DB_INSTANCE=SQLEXPRESS
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false
# DB_AUTO_MIGRATE=true
