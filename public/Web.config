<?xml version="1.0" encoding="utf-8"?>
<!--
  Trilha da Inclusão CAR — configuração ASP.NET (para hospedagem em IIS,
  usada quando o Node.js não é uma opção no servidor — ver README.md).

  Os dados sensíveis (connection string do SQL Server, chave do admin)
  ficam em connectionStrings.config e appSettings.config, que NÃO são
  versionados (ver os arquivos .example ao lado).
-->
<configuration>
  <connectionStrings configSource="connectionStrings.config" />
  <appSettings configSource="appSettings.config" />

  <system.web>
    <compilation targetFramework="4.8" debug="false">
      <assemblies>
        <add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" />
        <add assembly="System.Data, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" maxRequestLength="51200" requestValidationMode="2.0" />
    <customErrors mode="RemoteOnly" />
    <httpCookies requireSSL="false" />
    <!-- Sem isto, num Windows Server configurado em português o ASP.NET pode
         ler os próprios arquivos .ashx (que têm acentos no código-fonte,
         ex.: "Não reproduzo preconceitos.") e decodificar requisições/
         respostas usando um encoding diferente de UTF-8, corrompendo
         qualquer acento — é a causa do texto embaralhado no /admin.html. -->
    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" culture="pt-BR" uiCulture="pt-BR" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <!-- Não é preciso bloquear *.config aqui: o IIS já traz essa extensão
         negada por padrão no nível do servidor (applicationHost.config).
         Redeclarar a mesma entrada aqui causa erro de configuração
         (chave duplicada) e derruba o site com HTTP 500.19. -->
  </system.webServer>
</configuration>
