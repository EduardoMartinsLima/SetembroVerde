# Copie para ".env" (mesma pasta) e preencha. O ".env" NUNCA é versionado.

# --- SurveyCTO ---
SCTO_SERVIDOR=https://bpcomponente2.surveycto.com
SCTO_USUARIO=programabahiaprodutiva@gmail.com
SCTO_SENHA=
SCTO_FORM_ID=registro_de_informaes_ambientais_e_sociais_do_plano_de_investimentos
# Data fixa do filtro "date" da API (traz tudo enviado a partir dela)
SCTO_DATA_INICIAL=Oct 13, 2015 00:00:00 AM

# Intervalo de atualização em segundos. O SurveyCTO só permite baixar a base
# completa a cada ~300 s; valores menores tendem a receber erro 417.
INTERVALO_SEGUNDOS=300

# --- Painel ---
PORTA=3100
# Opcional: protege o painel com usuário/senha (HTTP Basic). Recomendado, pois
# os dados incluem informações pessoais de presidentes (LGPD).
PAINEL_USUARIO=
PAINEL_SENHA=

# Campos-chave (deixe em branco para detecção automática pelo nome da coluna)
CAMPO_EDITAL=
CAMPO_ID_OP=
CAMPO_NOME_OP=
CAMPO_MUNICIPIO=
